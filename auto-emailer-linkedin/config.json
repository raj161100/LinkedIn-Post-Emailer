{
  "experience": {
    "max_years": 4,
    "entry_terms": [
      "entry level",
      "junior",
      "graduate",
      "intern"
    ]
  },
  "phrase_filters": {
    "exclude": [
      "no h1b",
      "no h-1b",
      "us citizen",
      "usc only",
      "usc and gc only",
      "no sponsorship",
      "cannot sponsor",
      "sponsorship not available",
      "gc only",
      "only gc",
      "must be gc",
      "us only",
      "us persons only",
      "citizens only",
      "no visa",
      "no cpt",
      "no opt"
    ],
    "prefer": [
      "h1b ok",
      "h1b accepted",
      "h-1b ok",
      "visa sponsorship",
      "sponsorship available",
      "open to h1b",
      "can sponsor",
      "h1b welcome",
      "h1b transfer",
      "visa supported",
      "will sponsor",
      "h1b candidates",
      "provides sponsorship"
    ]
  },
  "visa_filters": {
    "exclude": [
      "no h1b",
      "no h-1b",
      "no sponsorship",
      "cannot sponsor",
      "sponsorship not available",
      "no visa",
      "no cpt",
      "no opt",
      "no stem opt"
    ],
    "prefer": [
      "opt",
      "stem opt",
      "cpt",
      "h1b",
      "h1-b",
      "visa sponsorship",
      "can sponsor",
      "will sponsor"
    ]
  },
  "location_filters": {
    "include": [
      "usa",
      "united states",
      "remote",
      "hybrid",
      "new jersey",
      "new york",
      "texas",
      "california",
      "philadelphia",
      "georgia",
      "virginia"
    ],
    "exclude": [
      "india",
      "canada",
      "mexico",
      "europe",
      "australia"
    ]
  },
  "auto_apply": {
    "enabled": false,
    "limit_per_run": 2
  },
  "job_cooldown_days": 10,
  "job_cache_file": "data/jobs_seen.jsonl",
  "roles": [
    {
      "name": ".NET Developer",
      "keywords": [
        ".NET Developer",
        "ASP.NET Core Developer",
        "C# Developer",
        "Azure Developer",
        "Full Stack .NET"
      ],
      "resume_path": "assets/PLACEHOLDER_RESUME.docx",
      "message_subject": "Application: .NET Developer (customize in dashboard)",
      "message_body": "Hello,\n\nI noticed your post for a .NET Developer position. I specialize in building scalable full-stack solutions using C#, ASP.NET Core, and Azure Cloud. Please find my resume attached.\n\nThank you,\n<Your Name>",
      "customize": {
        "enabled": true,
        "base_resume": "templates/base_NET_resume.docx"
      },
      "required_skills": [
        ".net",
        "c#",
        "asp.net",
        "web api",
        "azure"
      ]
    },
